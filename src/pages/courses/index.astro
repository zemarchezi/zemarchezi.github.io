---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const courses = (await getCollection('courses')).sort((a, b) =>
  b.data.semester.localeCompare(a.data.semester)
);
---

<Layout
  title="Courses — José Marchezi"
  description="Courses, lectures, notes, and course materials."
  activePath="/courses/"
>
  <section style="border-top:none;">
    <div class="wrap">
      <div class="section-head">
        <div>
          <div class="section-label">Teaching</div>
          <h2 class="section-title">Courses &amp; materials</h2>
        </div>
        <div class="section-note">Organized by course — slides, lecture notes, and problem sets.</div>
      </div>
      <div class="course-list">
        {courses.map((course) => (
          <a href={`/courses/${course.id}/`} class="course-row">
            <span class="course-code">{course.data.code}</span>
            <div class="course-info">
              <h4>{course.data.name}</h4>
              <span>
                {course.data.status ??
                  `${course.data.lectureCount ?? 0} lectures${
                    course.data.assignmentCount ? ` · ${course.data.assignmentCount} assignments` : ''
                  }`}
              </span>
            </div>
            <span class="course-meta">{course.data.semester}</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
