<Layout
  title="Research — José Marchezi"
  description="Research areas and publications in space weather and radiation belt physics."
  activePath="/research/"
>
  <section style="border-top:none;">
    <div class="wrap">
      <div class="eyebrow">Space Weather · Radiation Belt Physics</div>
      <h1 class="display">Research</h1>
      <p class="hero-sub">
        Physical and statistical modeling of particle dynamics in planetary radiation belts, and
        its application to operational space weather forecasting — currently Director of Space
        and Atmospheric Sciences at INPE.
      </p>
    </div>
  </section>

  <section id="areas">
    <div class="wrap">
      <div class="section-head">
        <div>
          <div class="section-label">Research areas</div>
          <h2 class="section-title">What I study</h2>
        </div>
        <div class="section-note">
          Four connected fronts: radiation belt physics at Earth and Saturn, geomagnetically
          induced currents, and machine learning applications in geophysics.
        </div>
      </div>
      <div class="research-grid">
        <div class="research-card">
          <span class="swatch c1"></span>
          <span class="research-tag">CNPq · Brazil</span>
          <h3>Geomagnetically induced currents</h3>
          <p>
            High time-resolution study of GICs across Brazilian territory, and how particle
            precipitation in the South Atlantic Magnetic Anomaly drives ground-level geomagnetic
            disturbances.
          </p>
        </div>
        <div class="research-card">
          <span class="swatch c2"></span>
          <span class="research-tag">Van Allen Probes · RBSP</span>
          <h3>Wave-particle interactions in Earth's radiation belts</h3>
          <p>
            ULF and EMIC wave contributions to relativistic electron flux dynamics in the outer
            Van Allen belt, from doctoral work through ongoing postdoctoral research.
          </p>
        </div>
        <div class="research-card">
          <span class="swatch c3"></span>
          <span class="research-tag">Cassini · MIMI</span>
          <h3>Radiation belt dynamics at Saturn</h3>
          <p>
            Extending radial-diffusion and wave-particle scattering methods developed for Earth
            to Saturn's radiation belts, using Earth as a physical prototype.
          </p>
        </div>
        <div class="research-card">
          <span class="swatch c4"></span>
          <span class="research-tag">UNICAMP · Petrobras</span>
          <h3>Machine learning for rock physics</h3>
          <p>
            Data augmentation and machine learning methods to improve rock-physics models and
            seismic inversion from well-log data.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section id="publications">
    <div class="wrap">
      <div class="section-head">
        <div>
          <div class="section-label">Publications</div>
          <h2 class="section-title">Articles &amp; preprints</h2>
        </div>
        <div class="section-note">
          31 peer-reviewed articles · full record on
          {' '}<a href="https://orcid.org/0000-0002-2904-6411" target="_blank" rel="noopener noreferrer">ORCID</a>
          {' '}and
          {' '}<a href="http://lattes.cnpq.br/6703205246809109" target="_blank" rel="noopener noreferrer">Lattes</a>.
        </div>
      </div>

      <h3 class="pub-group-label">First-author</h3>
      <ul class="pub-list">
        {firstAuthorPublications.map((pub) => (
          <li>
            <span class="pub-year">{pub.year}</span>
            <div class="pub-info">
              <h4><a href={`https://doi.org/${pub.doi}`} target="_blank" rel="noopener noreferrer">{pub.title}</a></h4>
              <span>{pub.authors} · {pub.venue}</span>
            </div>
            <span class="pub-tag">{pub.doi}</span>
          </li>
        ))}
      </ul>

      <h3 class="pub-group-label">Co-authored</h3>
      <ul class="pub-list">
        {coAuthoredPublications.map((pub) => (
          <li>
            <span class="pub-year">{pub.year}</span>
            <div class="pub-info">
              <h4><a href={`https://doi.org/${pub.doi}`} target="_blank" rel="noopener noreferrer">{pub.title}</a></h4>
              <span>{pub.authors} · {pub.venue}</span>
            </div>
            <span class="pub-tag">{pub.doi}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Layout>

<style>
  .eyebrow {
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--ink-faint);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    margin-bottom: 18px;
  }
  h1.display {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(36px, 5vw, 52px);
    line-height: 1.06;
    letter-spacing: -0.01em;
    margin: 0 0 22px;
  }
  .hero-sub {
    font-size: 17px;
    line-height: 1.6;
    color: var(--ink-soft);
    max-width: 560px;
    margin: 0;
  }

  .pub-group-label {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--flux-violet);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin: 40px 0 0;
    font-weight: 500;
  }
  .pub-group-label:first-of-type {
    margin-top: 0;
  }

  .pub-list {
    list-style: none;
    margin: 12px 0 0;
    padding: 0;
    border-top: 1px solid var(--rule);
  }
  .pub-list li {
    display: grid;
    grid-template-columns: 56px 1fr auto;
    gap: 20px;
    align-items: start;
    padding: 18px 4px;
    border-bottom: 1px solid var(--rule);
  }
  .pub-year {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--flux-violet);
    padding-top: 2px;
  }
  .pub-info h4 {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 16px;
    margin: 0 0 4px;
    line-height: 1.35;
  }
  .pub-info h4 a {
    text-decoration: none;
    color: var(--ink);
  }
  .pub-info h4 a:hover {
    color: var(--flux-violet);
  }
  .pub-info span {
    font-size: 12.5px;
    color: var(--ink-faint);
  }
  .pub-tag {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--ink-faint);
    text-align: right;
    white-space: nowrap;
    padding-top: 3px;
  }

  @media (max-width: 860px) {
    .pub-list li {
      grid-template-columns: 1fr;
      gap: 4px;
    }
    .pub-tag {
      text-align: left;
    }
  }
</style>
