---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const courses = (await getCollection('courses')).sort((a, b) =>
  b.data.semester.localeCompare(a.data.semester)
);
---

<Layout
  title="Disciplinas — José Marchezi"
  description="Disciplinas, aulas, notas e materiais de curso."
  activePath="/disciplinas/"
>
  <section style="border-top:none;">
    <div class="wrap">
      <div class="section-head">
        <div>
          <div class="section-label">Ensino</div>
          <h2 class="section-title">Disciplinas &amp; materiais</h2>
        </div>
        <div class="section-note">Organizado por curso — slides, notas de aula e listas de exercícios.</div>
      </div>
      <div class="course-list">
        {courses.map((course) => (
          <a href={`/disciplinas/${course.id}/`} class="course-row">
            <span class="course-code">{course.data.code}</span>
            <div class="course-info">
              <h4>{course.data.name}</h4>
              <span>
                {course.data.status ??
                  `${course.data.lectureCount ?? 0} aulas${
                    course.data.assignmentCount ? ` · ${course.data.assignmentCount} trabalhos` : ''
                  }`}
              </span>
            </div>
            <span class="course-meta">{course.data.semester}</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
