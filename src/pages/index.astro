---
import Layout from '../layouts/Layout.astro';
import BeltAnimation from '../components/BeltAnimation.astro';
import { getCollection } from 'astro:content';

const courses = (await getCollection('courses')).sort((a, b) =>
  b.data.semester.localeCompare(a.data.semester)
);
---

<Layout activePath="/">
  <section class="hero" style="border-top:none;">
    <div class="wrap hero-grid">
      <div>
        <div class="eyebrow">Space Weather · Radiation Belt Physics</div>
        <h1 class="hero-sub">
          José Paulo Marchezi — pesquisador em clima espacial, dinâmica de elétrons no cinturão de
          radiação externo, geomagnetismo e correntes geomangeticamente induzidas.
        </h1>
        <div class="hero-cta">
          <a href="/pesquisa/" class="btn primary">Ver pesquisa</a>
          <a href="/disciplinas/" class="btn ghost">Disciplinas →</a>
        </div>
      </div>

      <div>
        <BeltAnimation />
      </div>
    </div>
  </section>

  <section id="pesquisa">
    <div class="wrap">
      <div class="section-head">
        <div>
          <div class="section-label">Linhas de pesquisa</div>
          <h2 class="section-title">O que eu estudo</h2>
        </div>
        <div class="section-note">
          Três frentes conectadas: modelagem física, engenharia de dados e sistemas operacionais.
        </div>
      </div>
      <div class="research-grid">
        <div class="research-card">
          <span class="swatch c1"></span>
          <span class="research-tag">PINN · v6/v7</span>
          <h3>Redes neurais informadas por física</h3>
          <p>
            Modelos de fluxo de elétrons no cinturão de radiação externo, combinando dados
            RBSP/REPT com restrições físicas explícitas.
          </p>
        </div>
        <div class="research-card">
          <span class="swatch c2"></span>
          <span class="research-tag">RBSP · MagEIS</span>
          <h3>Distribuições de velocidade em tempestades</h3>
          <p>
            Análise estatística de distribuições ajustadas de elétrons ao longo das fases de
            tempestades geomagnéticas.
          </p>
        </div>
        <div class="research-card">
          <span class="swatch c3"></span>
          <span class="research-tag">Nowcast · Operacional</span>
          <h3>climaespacial.com.br</h3>
          <p>
            Serviço operacional de previsão de curtíssimo prazo com FastAPI, TimescaleDB e
            estimativa de incerteza via Monte Carlo Dropout.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section id="disciplinas">
    <div class="wrap">
      <div class="section-head">
        <div>
          <div class="section-label">Ensino</div>
          <h2 class="section-title">Disciplinas &amp; materiais</h2>
        </div>
        <div class="section-note">Organizado por curso — slides, notas de aula e listas de exercícios.</div>
      </div>
      <div class="course-list">
        {courses.map((course) => (
          <a href={`/disciplinas/${course.id}/`} class="course-row">
            <span class="course-code">{course.data.code}</span>
            <div class="course-info">
              <h4>{course.data.name}</h4>
              <span>
                {course.data.status ??
                  `${course.data.lectureCount ?? 0} aulas${
                    course.data.assignmentCount ? ` · ${course.data.assignmentCount} trabalhos` : ''
                  }`}
              </span>
            </div>
            <span class="course-meta">{course.data.semester}</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero {
    position: relative;
    padding: 100px 0 80px;
    overflow: hidden;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 40px;
    align-items: center;
  }
  .hero-grid > div {
    min-width: 0;
  }
  .eyebrow {
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--ink-faint);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    margin-bottom: 18px;
  }
  h1.hero-sub {
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 19px;
    line-height: 1.6;
    color: var(--ink-soft);
    max-width: 460px;
    margin: 0 0 32px;
  }
  .hero-cta {
    display: flex;
    gap: 14px;
  }

  @media (max-width: 860px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
    .hero-grid > div:last-child {
      order: -1;
      max-width: 280px;
      margin: 0 auto;
    }
  }
</style>
