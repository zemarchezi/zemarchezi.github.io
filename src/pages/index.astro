---
import Layout from '../layouts/Layout.astro';
import BeltAnimation from '../components/BeltAnimation.astro';
import { getCollection } from 'astro:content';

const courses = (await getCollection('courses')).sort((a, b) =>
  b.data.semester.localeCompare(a.data.semester)
);
---

<Layout activePath="/">
  <section class="hero" style="border-top:none;">
    <div class="wrap hero-grid">
      <div>
        <div class="eyebrow">Space Weather · Radiation Belt Physics</div>
        <h1 class="hero-sub">
          José Paulo Marchezi — space weather researcher.
        </h1>
        <div class="hero-cta">
          <a href="/research/" class="btn primary">View research</a>
          <a href="/courses/" class="btn ghost">Courses →</a>
        </div>
      </div>

      <div>
        <BeltAnimation />
      </div>
    </div>
  </section>

  <section id="research">
    <div class="wrap">
      <div class="section-head">
        <div>
          <div class="section-label">Research areas</div>
          <h2 class="section-title">What I study</h2>
        </div>
        <div class="section-note">
          Four connected fronts: radiation belt physics at Earth and Saturn, geomagnetically
          induced currents, and machine learning applications in geophysics.
        </div>
      </div>
      <div class="research-grid">
        <div class="research-card">
          <span class="swatch c1"></span>
          <span class="research-tag">CNPq · Brazil</span>
          <h3>Geomagnetically induced currents</h3>
          <p>
            High time-resolution study of GICs across Brazilian territory, and how particle
            precipitation in the South Atlantic Magnetic Anomaly drives ground-level geomagnetic
            disturbances.
          </p>
        </div>
        <div class="research-card">
          <span class="swatch c2"></span>
          <span class="research-tag">Van Allen Probes · RBSP</span>
          <h3>Wave-particle interactions in Earth's radiation belts</h3>
          <p>
            ULF and EMIC wave contributions to relativistic electron flux dynamics in the outer
            Van Allen belt, from doctoral work through ongoing postdoctoral research.
          </p>
        </div>
        <div class="research-card">
          <span class="swatch c3"></span>
          <span class="research-tag">Cassini · MIMI</span>
          <h3>Radiation belt dynamics at Saturn</h3>
          <p>
            Extending radial-diffusion and wave-particle scattering methods developed for Earth
            to Saturn's radiation belts, using Earth as a physical prototype.
          </p>
        </div>
        <div class="research-card">
          <span class="swatch c4"></span>
          <span class="research-tag">UNICAMP · Petrobras</span>
          <h3>Machine learning for rock physics</h3>
          <p>
            Data augmentation and machine learning methods to improve rock-physics models and
            seismic inversion from well-log data.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section id="courses">
    <div class="wrap">
      <div class="section-head">
        <div>
          <div class="section-label">Teaching</div>
          <h2 class="section-title">Courses &amp; materials</h2>
        </div>
        <div class="section-note">Organized by course — slides, lecture notes, and problem sets.</div>
      </div>
      <div class="course-list">
        {courses.map((course) => (
          <a href={`/courses/${course.id}/`} class="course-row">
            <span class="course-code">{course.data.code}</span>
            <div class="course-info">
              <h4>{course.data.name}</h4>
              <span>
                {course.data.status ??
                  `${course.data.lectureCount ?? 0} lectures${
                    course.data.assignmentCount ? ` · ${course.data.assignmentCount} assignments` : ''
                  }`}
              </span>
            </div>
            <span class="course-meta">{course.data.semester}</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero {
    position: relative;
    padding: 100px 0 80px;
    overflow: hidden;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 40px;
    align-items: center;
  }
  .hero-grid > div {
    min-width: 0;
  }
  .eyebrow {
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--ink-faint);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    margin-bottom: 18px;
  }
  h1.hero-sub {
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 19px;
    line-height: 1.6;
    color: var(--ink-soft);
    max-width: 460px;
    margin: 0 0 32px;
  }
  .hero-cta {
    display: flex;
    gap: 14px;
  }

  @media (max-width: 860px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
    .hero-grid > div:last-child {
      order: -1;
      max-width: 280px;
      margin: 0 auto;
    }
  }
</style>
